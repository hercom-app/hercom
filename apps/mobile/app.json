{
  "expo": {
    "name": "Hercom",
    "slug": "choferes-reemplazo-driver",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "choferes",
    "assetBundlePatterns": ["assets/**/*"],
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.proyecto.choferes",
      "config": {
        "googleMapsApiKey": "AIzaSyBbjTrcUBbeNw84CP_0BDOWoTe99WiHJWQ"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hercom usa tu ubicación para completar el punto de recojo y, si eres chofer, compartir el recorrido del viaje con el cliente.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Durante un viaje, Hercom registra tu recorrido aunque uses Waze u otra app, para que el cliente y soporte vean la ruta real.",
        "UIBackgroundModes": [
          "location"
        ],
        "NSCameraUsageDescription": "Hercom necesita la cámara para la foto selfie de tu identidad.",
        "LSApplicationQueriesSchemes": [
          "waze"
        ]
      }
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0B70FE",
      "translucent": true
    },
    "android": {
      "package": "com.proyecto.choferes",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B70FE"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBbjTrcUBbeNw84CP_0BDOWoTe99WiHJWQ"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-solid.png",
          "resizeMode": "cover",
          "backgroundColor": "#0B70FE"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hercom necesita acceso a fotos para subir imágenes del brevete.",
          "cameraPermission": "Hercom necesita la cámara para la foto selfie de tu identidad."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hercom usa tu ubicación para completar el punto de recojo y, si eres chofer, compartir el recorrido del viaje con el cliente.",
          "locationAlwaysAndWhenInUsePermission": "Durante un viaje, Hercom registra tu recorrido aunque uses Waze u otra app, para que el cliente y soporte vean la ruta real.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0B70FE",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-updates"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d19ae84f-d2a4-4dbc-a727-6c4935de3906",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "d19ae84f-d2a4-4dbc-a727-6c4935de3906"
      }
    },
    "owner": "hercom-worker"
  }
}
