# Generado automáticamente por `convex dev`. No edites manualmente la URL del deployment.
CONVEX_DEPLOYMENT=

# Google OAuth (Gmail) — crear credenciales en Google Cloud Console
# Ver docs/convex-google-auth.md
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# RENIEC vía Decolecta — consulta DNI (solo backend, nunca en la app)
# Ver docs/registro-chofer.md
DECOLECTA_API_KEY=

# Licencia de conducir vía VerificaPE — consulta brevete (solo backend)
VERIFICAPE_API_KEY=

# Correo de confirmación de viajes corporativos (Gmail SMTP).
# Contraseña de aplicación de Google (https://myaccount.google.com/apppasswords).
# Configúralo en el dashboard de Convex (producción), no en Vercel.
GMAIL_SMTP_USER=hercom.desarrollo@gmail.com
GMAIL_SMTP_PASSWORD=
QUOTE_FROM_EMAIL=HERCOM <hercom.desarrollo@gmail.com>

# Izipay / Lyra (Mi Cuenta Web) — solo en dashboard Convex, modo TEST
# Back Office → Configuración → Tienda → Claves de API REST
# LYRA_REST_USER=50595278
# LYRA_REST_PASSWORD=<contraseña de test>
# LYRA_PUBLIC_KEY=50595278:testpublickey_...
# LYRA_API_BASE=https://api.micuentaweb.pe

# Requerido por Convex Auth (se configura con `npx @convex-dev/auth`).
# JWT_PRIVATE_KEY y JWKS se crean automáticamente en el dashboard de Convex.
