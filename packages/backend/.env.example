# Generado automáticamente por `convex dev`. No edites manualmente la URL del deployment.
CONVEX_DEPLOYMENT=

# Google OAuth (Gmail) — crear credenciales en Google Cloud Console
# Ver docs/convex-google-auth.md
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# RENIEC vía Decolecta — consulta DNI (solo backend, nunca en la app)
# Ver docs/registro-chofer.md
DECOLECTA_API_KEY=

# Requerido por Convex Auth (se configura con `npx @convex-dev/auth`).
# JWT_PRIVATE_KEY y JWKS se crean automáticamente en el dashboard de Convex.
